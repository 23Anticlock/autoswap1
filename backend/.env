# ─── Server ───────────────────────────────────
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_string

# ─── CORS ─────────────────────────────────────
# Add your Netlify URL here once deployed (comma-separated)
# Example: https://autoswap.netlify.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────
DB_PATH=./autoswap.db

# ─── Binance ──────────────────────────────────
BINANCE_BASE_URL=https://api.binance.com
